# Application
APP_NAME=EarthData
APP_ENV=local
APP_DEBUG=true
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Database
DATABASE_URL=postgresql+asyncpg://earthdata:earthdata@localhost:5432/earthdata
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Earth observation source (NASA EONET - no API key required)
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
EONET_TIMEOUT_SECONDS=10
EONET_MAX_RETRIES=3
